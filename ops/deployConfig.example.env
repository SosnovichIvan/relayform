# Не содержит секретов. Скопируйте на VPS вне Git, например /etc/relayform/deploy.env.
DEPLOY_USER=relayform
DEPLOY_PATH=/opt/relayform
GIT_REPOSITORY=git@github.com:SosnovichIvan/relayform.git
GIT_BRANCH=main
GIT_SSH_KEY_PATH=/home/relayform/.ssh/relayformDeployKey

# Этот файл существует только на VPS и хранит остальные runtime-настройки/секреты.
APP_ENV_FILE=/opt/relayform/.env.production
# Токены сервисных ботов хранятся только в отдельном файле на VPS.
APP_TOKENS_FILE=/opt/relayform/.env.tokens
COMPOSE_FILE=dockerCompose.production.yml
APP_HTTP_PORT=3000
APP_HEALTH_PATH=/api/health

APP_DOMAIN=relayform.example.com
LETSENCRYPT_EMAIL=admin@example.com
VPS_PUBLIC_IPV4=203.0.113.10
TIMEZONE=Europe/Moscow
ENABLE_UFW=true
