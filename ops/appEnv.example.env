# Скопируйте на VPS как /opt/relayform/.env.production.
# Файл не содержит provider credentials; реальные runtime-файлы не коммитятся.
NODE_ENV=production

# Process-local MVP limit for POST /v1/events, independently per project.
EVENT_RATE_LIMIT_MAX=60
EVENT_RATE_LIMIT_WINDOW_MS=60000

# Public username without a leading @; used to construct activation links.
TELEGRAM_BOT_USERNAME=relayform_bot

# Numeric Relayform community ID and its public conversation/profile URL.
VK_COMMUNITY_ID=123456789
VK_COMMUNITY_URL=https://vk.com/relayform

# Public MAX bot name used to construct one-time activation deep links.
MAX_BOT_USERNAME=relayform_bot

# Public HTTPS origin used only to build confirmation links.
PUBLIC_APP_URL=https://relayform.ru

# Verified transactional sender configured at the selected provider.
EMAIL_FROM_ADDRESS=Relayform <confirm@relayform.ru>

# Independent per-project confirmation request limit.
EMAIL_VERIFICATION_RATE_LIMIT_MAX=10
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=60000
